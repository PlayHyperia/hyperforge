# Docker ignore - exclude large files from build context

# Node modules (installed fresh in container)
node_modules
**/node_modules

# Build outputs (built fresh in container)  
**/dist
**/build
**/.next
**/*.tsbuildinfo
.turbo

# Git
.git
.gitignore

# IDE
.vscode
.cursor
.idea
*.swp
*.swo

# Test files
**/coverage
**/test-results
**/playwright-report
**/__tests__/
**/tests/
**/*.test.*
**/*.spec.*
**/*.e2e.*

# Retained local qualification evidence is never a production build input.
artifacts/
progress-videos/
heap-snapshots/
**/*.cpuprofile
**/*.heapsnapshot

# Development files
*.log
.env
.env.*
!.env.example

# Documentation
*.md
!README.md

# Large asset directories (served from CDN)
# Keep manifests in build context so server boots even if CDN manifests are partial.
packages/server/world/assets/*
!packages/server/world/assets/manifests/
!packages/server/world/assets/manifests/**
assets/

# Other packages not needed for server
packages/asset-forge/**
!packages/asset-forge/package.json
packages/app/**
!packages/app/package.json
packages/website/**
!packages/website/package.json
packages/docs-site

# Tools and publishing (not needed for build)
tools/
publishing/

# OS files
.DS_Store
Thumbs.db
