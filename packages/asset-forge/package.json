{
  "name": "@hyperforge/asset-forge",
  "version": "1.0.0",
  "description": "AI-powered 3D asset generation system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "bun server/api-elysia.ts",
    "build": "bun run clean && vite build",
    "build:services": "bun scripts/build-services.mjs",
    "start": "bun run start:api",
    "start:api": "bun run build:services && bun server/api-elysia.ts",
    "clean": "bun scripts/clean.mjs",
    "lint": "eslint src",
    "preview": "vite preview",
    "assets:audit": "bun x tsx scripts/audit-assets.ts",
    "assets:normalize": "bun x tsx scripts/normalize-all-assets.ts",
    "check:deps": "depcheck",
    "check:all": "knip",
    "count:lines": "bun scripts/count-lines.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:unit:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:ui": "playwright test --ui",
    "db:generate": "bun x drizzle-kit generate",
    "db:push": "bun x drizzle-kit push",
    "db:studio": "bun x drizzle-kit studio"
  },
  "keywords": [
    "ai",
    "3d",
    "generation",
    "meshy",
    "gpt-5",
    "rpg",
    "game-assets"
  ],
  "author": "Lucid",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.46",
    "@ai-sdk/openai": "^3.0.41",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/server-timing": "^1.4.0",
    "@elysiajs/static": "^1.4.6",
    "@elysiajs/swagger": "^1.3.1",
    "@gltf-transform/core": "^4.3.0",
    "@hyperforge/decimation": "workspace:*",
    "@hyperforge/impostor": "workspace:*",
    "@hyperforge/procgen": "workspace:*",
    "@hyperforge/shared": "workspace:*",
    "@mediapipe/hands": "^0.4.1675469240",
    "@pixiv/three-vrm": "3.5.5",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.0.0",
    "@sinclair/typebox": "^0.34.41",
    "@tensorflow-models/hand-pose-detection": "^2.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "ai": "^6.0.116",
    "chalk": "^4.1.2",
    "clsx": "^2.0.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.6",
    "elevenlabs": "^1.59.0",
    "elysia": "^1.4.15",
    "elysia-rate-limit": "^4.4.2",
    "express": "^4.18.2",
    "glob": "^13.0.6",
    "immer": "^11.1.8",
    "lucide-react": "^1.8.0",
    "node-fetch": "^3.3.2",
    "postgres": "^3.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.13.0",
    "styled-components": "^6.1.0",
    "tailwind-merge": "^3.3.1",
    "three": "0.186.0",
    "three-mesh-bvh": "^0.9.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.7",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "4.1.8",
    "autoprefixer": "^10.4.16",
    "depcheck": "^1.4.7",
    "drizzle-kit": "^0.31.5",
    "eslint": "^10.0.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "knip": "^6.4.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "4.1.8"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
