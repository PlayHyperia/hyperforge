{
  "name": "@hyperforge/shared",
  "version": "0.13.0",
  "type": "module",
  "main": "build/framework.js",
  "types": "build/framework.d.ts",
  "bin": {
    "hyperia": "build/cli.js"
  },
  "exports": {
    ".": {
      "types": "./build/framework.d.ts",
      "import": "./build/framework.js",
      "require": "./build/framework.js"
    },
    "./client": {
      "types": "./build/framework.d.ts",
      "import": "./build/framework.client.js",
      "default": "./build/framework.client.js"
    }
  },
  "homepage": "https://github.com/PlayHyperia/hyperia#readme",
  "bugs": {
    "url": "https://github.com/PlayHyperia/hyperia/issues"
  },
  "keywords": [
    "hyperia",
    "3d",
    "components",
    "virtual-worlds",
    "metaverse",
    "three.js",
    "webgpu",
    "real-time"
  ],
  "scripts": {
    "dev": "bun scripts/dev-final.mjs",
    "dev:legacy": "bun scripts/dev.mjs",
    "dev:old": "bun scripts/build.mjs --dev",
    "prebuild": "bun run docs:extract",
    "build": "bun scripts/build.mjs",
    "build:client": "vite build",
    "build:server": "bun scripts/build.mjs --server-only",
    "start": "bun run build && bun build/index.js start --world ./world",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:client": "node test-client.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "docs:extract": "echo 'TSDoc extraction happens at root level via TypeDoc'",
    "cap:init": "cap init 'Hyperia' 'com.hyperia.app' --web-dir build/public",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "cap:ip": "node scripts/get-local-ip.mjs",
    "config:check": "node scripts/check-config.mjs",
    "config:check:mobile": "node scripts/check-config.mjs --mobile",
    "ios": "bun run build:client && cap sync ios && cap open ios",
    "ios:dev": "cap sync ios && cap open ios",
    "ios:build": "bun run build:client && cap sync ios && cap copy ios",
    "android": "bun run build:client && cap sync android && cap open android",
    "android:dev": "cap sync android && cap open android",
    "android:build": "bun run build:client && cap sync android && cap copy android"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@farcaster/miniapp-sdk": "^0.2.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.0",
    "@fastify/websocket": "^11.0.1",
    "@hyperforge/decimation": "workspace:*",
    "@hyperforge/impostor": "workspace:*",
    "@hyperforge/physx-js-webidl": "workspace:*",
    "@pixiv/three-vrm": "3.5.5",
    "@privy-io/react-auth": "^3.13.1",
    "@privy-io/server-auth": "^1.32.5",
    "@types/styled-components": "^5.1.34",
    "better-sqlite3": "^12.2.0",
    "commander": "^15.0.0",
    "d3": "^7.9.0",
    "dotenv": "^17.3.1",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "eventemitter3": "^5.0.1",
    "fastify": "^5.0.0",
    "find-cache-dir": "^6.0.0",
    "fs-extra": "^11.2.0",
    "hls.js": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "livekit-client": "^2.9.9",
    "livekit-server-sdk": "^2.11.0",
    "lodash-es": "^4.17.23",
    "lucide-react": "^1.8.0",
    "moment": "^2.30.1",
    "msgpackr": "^2.0.2",
    "nanoid": "^5.0.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "source-map-support": "^0.5.21",
    "sqlite3": "^6.0.1",
    "styled-components": "^6.1.19",
    "three": "0.186.0",
    "three-mesh-bvh": "^0.9.8",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.10",
    "@babel/preset-react": "^7.23.10",
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@hyperforge/procgen": "workspace:*",
    "@microsoft/api-extractor": "^7.52.10",
    "@playwright/test": "^1.58.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/source-map-support": "^0.5.10",
    "@types/three": "0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.0.6",
    "ajv": "^8.18.0",
    "ajv-draft-04": "^1.0.0",
    "autoprefixer": "^10.4.21",
    "chokidar": "^4.0.3",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.27.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jimp": "^1.6.0",
    "jsdom": "29.1.1",
    "playwright": "^1.55.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup": "^4.46.2",
    "rollup-plugin-dts": "^6.2.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "engines": {
    "node": ">=22.11.0",
    "bun": ">=1.3.14"
  },
  "overrides": {
    "three": "0.186.0",
    "jws": "^3.2.3"
  },
  "license": "GPL-3.0-only"
}
