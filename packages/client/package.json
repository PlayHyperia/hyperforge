{
  "name": "@hyperforge/client",
  "version": "0.13.0",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/PlayHyperia/hyperia#readme",
  "bugs": {
    "url": "https://github.com/PlayHyperia/hyperia/issues"
  },
  "keywords": [
    "hyperia",
    "3d",
    "components",
    "virtual-worlds",
    "metaverse",
    "three.js",
    "webgpu",
    "real-time"
  ],
  "scripts": {
    "dev": "vite --host --port 3333 --strictPort",
    "build": "cd ../.. && turbo run build --filter=@hyperforge/shared && cd packages/client && NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "build:cf": "NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "PW_HEADLESS=0 xvfb-run -a playwright test",
    "test:e2e:web3": "playwright test tests/e2e/web3-login.spec.ts",
    "test:e2e:web3:evm": "playwright test tests/e2e/web3-login.spec.ts --grep 'EVM'",
    "test:e2e:web3:solana": "playwright test tests/e2e/web3-login.spec.ts --grep 'Solana'",
    "test:e2e:full-flow": "playwright test tests/e2e/full-flow.spec.ts",
    "test:e2e:auth": "playwright test tests/e2e/auth.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "deploy:prod": "node scripts/deploy-cloudflare.mjs --production"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@farcaster/miniapp-sdk": "^0.2.1",
    "@hyperforge/impostor": "workspace:*",
    "@hyperforge/physx-js-webidl": "workspace:*",
    "@hyperforge/shared": "workspace:*",
    "@pixiv/three-vrm": "3.5.5",
    "@privy-io/react-auth": "^3.13.1",
    "@rollup/rollup-darwin-x64": "^4.52.4",
    "@solana-mobile/wallet-standard-mobile": "^0.5.0",
    "@solana-program/memo": "^0.11.0",
    "@solana/kit": "^6.0.1",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.3.0",
    "@xyflow/react": "^12.10.1",
    "buffer": "^6.0.3",
    "canonicalize": "^3.0.0",
    "d3": "^7.9.0",
    "eventemitter3": "^5.0.1",
    "fetch-retry": "^6.0.0",
    "hls.js": "^1.6.1",
    "livekit-client": "^2.9.9",
    "lodash-es": "^4.17.23",
    "lucide-react": "^1.8.0",
    "moment": "^2.30.1",
    "msgpackr": "^2.0.2",
    "nanoid": "^5.0.6",
    "postprocessing": "6.39.5",
    "react": "19.2.7",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.2.7",
    "three": "0.186.0",
    "three-custom-shader-material": "^6.3.7",
    "three-mesh-bvh": "^0.9.9",
    "viem": "^2.39.3",
    "vite-plugin-pwa": "^1.2.0",
    "yoga-layout": "^3.2.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.10",
    "@babel/preset-react": "^7.23.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "headless-web3-provider": "^0.3.2",
    "jsdom": "29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tweetnacl": "^1.0.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "engines": {
    "node": ">=22.11.0",
    "bun": ">=1.3.14"
  },
  "overrides": {
    "three": "0.186.0"
  },
  "license": "GPL-3.0-only"
}
