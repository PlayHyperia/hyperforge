# ===========================================
# ELIZAOS PLUGIN CONFIGURATION
# ===========================================
# Copy this file to .env to customize settings.
# These settings configure the ElizaOS server when running with `bun run dev:ai`.

# ElizaOS API server port (default: 4001)
# Changed from ElizaOS default (3000) to avoid conflicts with other services
PORT=4001
SERVER_PORT=4001

# Hyperia game server WebSocket URL
# This is where ElizaOS agents connect to play the game
HYPERIA_SERVER_URL=ws://localhost:5556/ws

# HTTP API used for replay-safe SOL wallet challenge/signature authentication.
HYPERIA_API_URL=http://localhost:5555

# The autonomous agent must control this SOL key. Accepted encodings are a
# canonical base58 64-byte Solana secret key, a canonical base58 32-byte seed,
# or a JSON byte array. Never commit or log the production value.
SOLANA_PRIVATE_KEY=
# Optional public address. When supplied, it must exactly match the key above.
SOLANA_PUBLIC_KEY=

# Auto-reconnect when disconnected from game server
HYPERIA_AUTO_RECONNECT=true
