{
  "name": "@hyperforge/server",
  "version": "0.13.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "homepage": "https://github.com/PlayHyperia/hyperia#readme",
  "bugs": {
    "url": "https://github.com/PlayHyperia/hyperia/issues"
  },
  "keywords": [
    "hyperia",
    "3d",
    "components",
    "virtual-worlds",
    "metaverse",
    "three.js",
    "webgpu",
    "real-time"
  ],
  "scripts": {
    "dev": "bun scripts/setup-chain.mjs && bun scripts/dev.mjs",
    "extract-bounds": "bun scripts/extract-model-bounds.ts",
    "fixtures:betting-feed": "bun scripts/generate-betting-feed-schema-v3-fixtures.ts",
    "fixtures:betting-feed:check": "bun scripts/generate-betting-feed-schema-v3-fixtures.ts --check",
    "fixtures:tactical-ablation": "bun scripts/generate-competitive-tactical-ablation.ts",
    "fixtures:tactical-ablation:check": "bun scripts/generate-competitive-tactical-ablation.ts --check",
    "build": "bun scripts/build-server.mjs",
    "prestart": "node ../../scripts/node-runtime-policy.mjs",
    "start": "node --import ./scripts/register-hooks.mjs ../../scripts/start-hyperia-server.mjs",
    "test": "bun run --cwd ../shared build && bun run --cwd ../impostors build && bun run --cwd ../plugin-hyperia build && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:streaming-authority-chaos": "bun scripts/test-streaming-authority-process-kill.ts",
    "test:agent-duel-cycle-chaos": "NODE_ENV=development bun scripts/test-agent-duel-cycle-process-kill.ts",
    "test:agent-duel-cycle-chaos:melee": "NODE_ENV=development AGENT_DUEL_CYCLE_CHAOS_ROLE=melee bun scripts/test-agent-duel-cycle-process-kill.ts",
    "test:agent-duel-cycle-chaos:ranged": "NODE_ENV=development AGENT_DUEL_CYCLE_CHAOS_ROLE=ranged bun scripts/test-agent-duel-cycle-process-kill.ts",
    "test:agent-duel-cycle-chaos:mage": "NODE_ENV=development AGENT_DUEL_CYCLE_CHAOS_ROLE=mage bun scripts/test-agent-duel-cycle-process-kill.ts",
    "test:agent-duel-cycle-chaos:roles": "bun run test:agent-duel-cycle-chaos:melee && bun run test:agent-duel-cycle-chaos:ranged && bun run test:agent-duel-cycle-chaos:mage",
    "test:agent-preparation-duel-combined": "bun run --cwd ../shared build && bun run build && NODE_ENV=development STREAMING_DUEL_ENABLED=true STREAMING_DUEL_PREPARATION_MS=60000 STREAMING_PERSIST_STATS=false STREAMING_AGENT_SKIP_DB_LOAD=false STREAMING_DUEL_COMBAT_AI_ENABLED=true EMBEDDED_AGENT_DUEL_PREPARATION_LLM=false STREAMING_ANNOUNCEMENT_MS=1000 STREAMING_COUNTDOWN_TICKS=1 STREAMING_FIGHTING_MS=300000 bun scripts/test-agent-preparation-to-duel-combined.ts",
    "test:agent-preparation-duel-combined:melee": "AGENT_DUEL_CYCLE_CHAOS_ROLE=melee bun run test:agent-preparation-duel-combined",
    "test:agent-preparation-duel-combined:ranged": "AGENT_DUEL_CYCLE_CHAOS_ROLE=ranged bun run test:agent-preparation-duel-combined",
    "test:agent-preparation-duel-combined:mage": "AGENT_DUEL_CYCLE_CHAOS_ROLE=mage bun run test:agent-preparation-duel-combined",
    "test:agent-preparation-duel-combined:multi-style": "AGENT_DUEL_CYCLE_CHAOS_ROLE=ranged AGENT_DUEL_COMBINED_MULTI_STYLE=true bun run test:agent-preparation-duel-combined",
    "test:agent-preparation-duel-combined:roles": "bun run test:agent-preparation-duel-combined:melee && bun run test:agent-preparation-duel-combined:ranged && bun run test:agent-preparation-duel-combined:mage && bun run test:agent-preparation-duel-combined:multi-style",
    "test:duel-preparation-unavailability-chaos": "bun scripts/test-duel-preparation-unavailability-process-kill.ts",
    "test:duel-preparation-host-lease-chaos": "bun scripts/test-duel-preparation-host-lease-process-kill.ts",
    "test:external-duel-preparation-host-lease-chaos": "bun scripts/test-external-duel-preparation-host-lease-process-kill.ts",
    "test:external-duel-preparation-host-lease-built-chaos": "bun run --cwd ../plugin-hyperia build && EXTERNAL_DUEL_PREPARATION_HOST_LEASE_PLUGIN_RUNTIME=built bun scripts/test-external-duel-preparation-host-lease-process-kill.ts",
    "test:agent-websocket-auth-built": "bun run --cwd ../shared build && bun run --cwd ../plugin-hyperia build && AGENT_WEBSOCKET_AUTH_PLUGIN_RUNTIME=built bun scripts/test-agent-websocket-auth-postgres.ts",
    "test:processing-quiescence-chaos": "NODE_ENV=development bun scripts/test-processing-quiescence-process-kill.ts",
    "test:processing-quiescence-live-world": "NODE_ENV=test SKIP_VALIDATION=true DATA_OPTIONAL_MANIFEST_WARNINGS=false DISABLE_BOTS=true DISABLE_ACTIVITY_LOGGER=true TERRAIN_SERVER_MESH_COLLISION_ENABLED=false bun scripts/test-processing-quiescence-live-world.mjs",
    "service:agent-duel-bet-sync-e2e": "bun scripts/run-agent-duel-bet-sync-service.ts",
    "seed:agent-duel-3d-e2e": "bun scripts/seed-agent-duel-3d-e2e.ts",
    "test:competitive-snapshot-chaos": "bun scripts/test-competitive-snapshot-process-kill.ts",
    "test:autonomy-checkpoint-chaos": "bun scripts/test-agent-autonomy-checkpoint-process-kill.ts",
    "test:autonomy-progression-chaos": "bun scripts/test-agent-autonomy-progression-process-kill.ts",
    "test:ordinary-bank-chaos": "bun scripts/test-ordinary-agent-bank-process-kill.ts",
    "test:external-bank-chaos": "bun scripts/test-external-agent-bank-process-kill.ts",
    "test:ordinary-store-chaos": "bun scripts/test-ordinary-agent-store-process-kill.ts",
    "test:ordinary-prayer-chaos": "bun scripts/test-ordinary-agent-prayer-process-kill.ts",
    "test:combat-loadout-chaos": "bun scripts/test-combat-loadout-process-kill.ts",
    "test:inventory-debit-chaos": "bun scripts/test-inventory-debit-process-kill.ts",
    "test:gathering-reward-chaos": "bun scripts/test-gathering-reward-process-kill.ts",
    "test:processing-action-chaos": "bun scripts/test-processing-action-process-kill.ts",
    "test:processing-station-population": "bun run --cwd ../shared build && vitest run src/systems/ServerNetwork/__tests__/TileMovementManager.test.ts && bun scripts/test-processing-action-process-kill.ts",
    "test:safe-death-chaos": "bun scripts/test-safe-death-custody-process-kill.ts",
    "test:prayer-state-chaos": "bun scripts/test-prayer-state-process-kill.ts",
    "test:equipment-debit-chaos": "bun scripts/test-equipment-debit-process-kill.ts",
    "test:projectile-cost-host-loss-chaos": "bun scripts/test-projectile-cost-host-loss-process-kill.ts",
    "test:food-consumption-chaos": "bun scripts/test-food-consumption-process-kill.ts",
    "test:quest-custody-chaos": "bun scripts/test-quest-custody-process-kill.ts",
    "test:ground-duel-progression-chaos": "bun scripts/test-ground-duel-progression-process-kill.ts",
    "test:duel-damage-terminal-chaos": "bun scripts/test-duel-damage-observation-process-kill.ts",
    "test:food-consumption-live-world": "bun run --cwd ../shared build && NODE_ENV=test SKIP_VALIDATION=true DATA_OPTIONAL_MANIFEST_WARNINGS=false DISABLE_BOTS=true DISABLE_ACTIVITY_LOGGER=true TERRAIN_SERVER_MESH_COLLISION_ENABLED=false bun scripts/test-food-consumption-live-world-postgres.ts",
    "test:player-health-live-world": "bun run --cwd ../shared build && NODE_ENV=test SKIP_VALIDATION=true DATA_OPTIONAL_MANIFEST_WARNINGS=false DISABLE_BOTS=true DISABLE_ACTIVITY_LOGGER=true TERRAIN_SERVER_MESH_COLLISION_ENABLED=false TEST_GENERIC_HEALTH_OUTAGE=true bun scripts/test-food-consumption-live-world-postgres.ts",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "stream:rtmp": "bun scripts/stream-to-rtmp.ts",
    "stream:alert:probe": "bun scripts/probe-streaming-alert-route.ts",
    "stream:test": "bun scripts/test-rtmp-local.ts",
    "test:webgpu": "bun scripts/test-webgpu.ts",
    "stream:test-canvas": "bun scripts/test-canvas-server.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:backup-recovery": "bun src/database/hyperia-postgres-backup-cli.ts",
    "db:restore-recovery-evidence": "bun src/database/hyperia-postgres-restore-evidence-cli.ts",
    "db:restored-duel-application-readiness": "bun src/database/hyperia-restored-duel-application-readiness-cli.ts",
    "db:test-backup-recovery": "bun scripts/test-hyperia-postgres-backup.ts",
    "db:verify-streaming-history-migration": "bun scripts/verify-streaming-duel-history-migration.ts",
    "db:verify-prayer-state-migration": "bun scripts/verify-prayer-state-migration.ts",
    "db:prayer-receipt-compaction": "bun src/database/prayer-receipt-compaction-cli.ts",
    "db:test-prayer-receipt-compaction": "bun scripts/test-prayer-receipt-compaction.ts",
    "audit:competitive-strategy-outcomes": "bun scripts/audit-competitive-strategy-outcomes.ts",
    "db:studio": "bunx drizzle-kit studio",
    "cdn:up": "docker-compose up -d cdn",
    "cdn:down": "docker-compose down cdn",
    "cdn:logs": "docker-compose logs -f cdn",
    "cdn:verify": "bun scripts/verify-cdn.mjs",
    "assets:sync": "bun scripts/sync-assets-smart.mjs from-git",
    "assets:deploy": "bun scripts/sync-assets-smart.mjs to-r2",
    "assets:verify": "bun scripts/sync-assets-smart.mjs verify",
    "assets:full": "bun scripts/sync-assets-smart.mjs both",
    "dev:full": "docker-compose up",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "deploy:prod": "node scripts/deploy-cloudflare.mjs --production"
  },
  "files": [
    "dist/",
    "world/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ai-sdk/openai": "^3.0.30",
    "@elizaos/core": "2.0.0-alpha.537",
    "@elizaos/plugin-anthropic": "2.0.0-alpha.537",
    "@elizaos/plugin-goals": "2.0.0-alpha.10",
    "@elizaos/plugin-groq": "2.0.0-alpha.10",
    "@elizaos/plugin-openai": "2.0.0-alpha.537",
    "@elizaos/plugin-sql": "2.0.0-alpha.20",
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^9.1.2",
    "@fastify/websocket": "^11.0.1",
    "@hyperforge/plugin-hyperia": "workspace:*",
    "@hyperforge/shared": "workspace:*",
    "@hyperforge/web3": "workspace:*",
    "@livekit/rtc-node": "^0.13.24",
    "@noble/curves": "^2.0.1",
    "@privy-io/server-auth": "^1.14.0",
    "@solana/web3.js": "^1.98.4",
    "ai": "^6.0.97",
    "commander": "^15.0.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "fastify": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.11.0",
    "moment": "^2.30.1",
    "msgpackr": "^2.0.2",
    "pg": "^8.13.1",
    "socket.io-client": "^4.8.1",
    "source-map-support": "^0.5.21",
    "uuid": "^14.0.0",
    "viem": "^2.46.2",
    "uWebSockets.js": "uNetworking/uWebSockets.js#v20.68.0",
    "ws": "^8.18.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment": "^2.13.0",
    "@types/node": "22.20.1",
    "@types/pg": "^8.11.10",
    "@types/source-map-support": "^0.5.10",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^4.1.8",
    "chokidar": "^4.0.3",
    "esbuild": "^0.27.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^9.1.0",
    "pg-mem": "^3.0.8",
    "playwright": "^1.55.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@types/ws": "^8.5.13"
  },
  "engines": {
    "node": "22.23.2",
    "bun": ">=1.3.14"
  },
  "overrides": {
    "three": "0.183.2"
  },
  "license": "GPL-3.0-only"
}
