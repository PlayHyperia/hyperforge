{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env"],
  "ui": "tui",
  "concurrency": "10",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "tsconfig.tsbuildinfo"],
      "cache": true
    },
    "extract-bounds": {
      "cache": true
    },
    "@hyperforge/physx-js-webidl#build": {
      "dependsOn": [],
      "outputs": ["dist/**", "PhysX/physx/compiler/emscripten-release/**"],
      "inputs": [
        "PhysX/physx/source/**",
        "PhysX/physx/include/**",
        "make.sh",
        "package.json"
      ],
      "cache": true
    },
    "@hyperforge/shared#build": {
      "dependsOn": ["^build", "@hyperforge/physx-js-webidl#build"],
      "outputs": ["dist/**", "build/**", "tsconfig.tsbuildinfo"],
      "cache": true
    },
    "@hyperforge/procgen#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"],
      "cache": true
    },
    "@hyperforge/client#build": {
      "dependsOn": [
        "^build",
        "@hyperforge/physx-js-webidl#build",
        "@hyperforge/shared#build"
      ],
      "outputs": ["dist/**", "build/**", "tsconfig.tsbuildinfo"],
      "cache": true
    },
    "@hyperforge/asset-forge#build": {
      "dependsOn": ["^build", "@hyperforge/procgen#build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"],
      "cache": true
    },
    "@hyperforge/plugin-hyperia#build": {
      "dependsOn": ["^build", "@hyperforge/shared#build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"],
      "cache": true
    },
    "@hyperforge/server#build": {
      "dependsOn": ["^build", "@hyperforge/shared#build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"],
      "cache": true
    },
    "@hyperforge/app#build": {
      "dependsOn": ["@hyperforge/client#build"],
      "outputs": [],
      "cache": false
    },
    "@hyperforge/contracts#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "@hyperforge/solana-prediction-market#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@hyperforge/app#dev": {
      "dependsOn": ["@hyperforge/client#build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true,
      "env": ["NODE_ENV"]
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
