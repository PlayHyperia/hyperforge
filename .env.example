# Hyperia Environment Variables
#
# FOR LOCAL DEVELOPMENT: Copy to .env and fill in your values
# FOR PRODUCTION (Vast.ai): Set these as GitHub Secrets in the repository
#
# Optional public fanout credentials belong in the deployment secret store.
# The owned HLS output remains canonical even when RTMP fanout is configured.
#   - DATABASE_URL
#   - SOLANA_DEPLOYER_PRIVATE_KEY
#   - VAST_HOST, VAST_PORT, VAST_SSH_KEY (for deployment)
#
# NEVER commit secrets to the repository - they will be exposed in git history

# Production game-server HMAC authority for authenticated mob-death loot.
# Every game-server authority must receive the same 32+ byte secret.
# KILL_TOKEN_SECRET=replace-with-32-or-more-random-bytes

# ============================================================================
# OPTIONAL EXTERNAL STREAM FANOUT
# ============================================================================

# Do not configure a destination until the exact launch channel is approved.
# Never commit stream keys or private/signed player URLs.

# Twitch
TWITCH_STREAM_KEY=
TWITCH_STREAM_URL=

# Kick
KICK_STREAM_KEY=
KICK_RTMP_URL=

# X
X_STREAM_KEY=
X_RTMP_URL=

# YouTube
YOUTUBE_STREAM_KEY=
YOUTUBE_STREAM_URL=

# Bettor-facing source. The integrated launcher sets the exact absolute HLS URL
# for both Hyperia and Hyperbet; these defaults describe standalone operation.
STREAMING_CANONICAL_PLATFORM=hls
STREAMING_CANONICAL_SOURCE_URL=/live/stream.m3u8
# STREAMING_PUBLIC_DELAY_MS=4000

# Require the encoder to use the browser's live PulseAudio monitor instead of
# generated silence in local/staging launch checks. Production always requires it.
STREAMING_REQUIRE_LIVE_AUDIO=false

# ============================================================================
# SOLANA KEYS (Required for on-chain features)
# ============================================================================

# Deployment authority (do not reuse as a production runtime role)
SOLANA_DEPLOYER_PRIVATE_KEY=

# Hyperia oracle integration roles:
# SOLANA_ARENA_AUTHORITY_SECRET=
# SOLANA_ARENA_REPORTER_SECRET=
# SOLANA_ARENA_KEEPER_SECRET=
# SOLANA_MM_PRIVATE_KEY=

# The Hyperbet keeper has its own explicit runtime roles. Configure them in
# the Hyperbet keeper environment. Mainnet requires distinct wallets for fee
# payer, reporter, finalizer, CLOB operator, market maker, and challenger.

# ============================================================================
# INTEGRATED SOL DUEL + HYPERBET STACK
# ============================================================================

# Enable the sibling Hyperbet SOL backend, browser app, and keeper.
DUEL_WITH_HYPERBET=false

# Optional explicit monorepo location. When blank, the launcher checks the
# sibling hyperbet-solana-implementation and hyperbet directories.
DUEL_HYPERBET_ROOT=

# Local backend origin used by the browser app (must remain loopback when the
# launcher owns the backend process).
DUEL_HYPERBET_API_URL=http://localhost:8080

# Persist this high-entropy secret in the runtime secret store when continuity
# across launcher restarts is required. If blank, the launcher generates an
# ephemeral 32-byte credential and passes it only to Hyperia and the keeper.
DUEL_BETTING_FEED_ACCESS_TOKEN=

# ============================================================================
# DATABASE (Production)
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=

# Bounded database recovery. Keep query timeout strictly above statement timeout.
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_QUERY_TIMEOUT_MS=20000

# ============================================================================
# DISPLAY (GPU Rendering - Vast.ai/Remote)
# ============================================================================

# Use :0 for real Xorg display, :99 for Xvfb
DISPLAY=:0

# Set to true when using Xvfb virtual display
DUEL_CAPTURE_USE_XVFB=false
